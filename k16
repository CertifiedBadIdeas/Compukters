set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
MANIFEST="$ROOT/host/k16-tools/Cargo.toml"

usage() {
    cat >&2 <<'EOF'
usage:
  k16 link [--target <boot|kernel|program>] <input.ko>... -o <output.kx>
  k16 runtime <k16-startup|k16-memory-helpers> -o <output.ko>
  k16 run <program.kx>
  k16 disasm --target <bios|boot|kernel|program> <input>
  k16 inspect <blob>
  k16 volume <create|init|put-boot|put-kernel> ...
  k16 fs <filesystem> ...
EOF
}

if [ "$#" -lt 1 ]; then
    usage
    exit 2
fi

exec cargo run --quiet --manifest-path "$MANIFEST" --bin k16 -- "$@"
