# See assets/k16/fonts/Spleen-LICENSE.txt for the upstream license notice.
# Edit this file, then run ./gradlew generateK16FontTables.
# Glyph bitmaps are fixed-size and placed inside the terminal cell by glyph_x/glyph_y.
font K16 Terminal
source assets/k16/fonts/k16-terminal.font
version 1
glyph_width 5
glyph_height 8
cell_width 5
cell_height 8
glyph_x 0
glyph_y 0
baseline 7
fallback U+FFFD

