use rux::abi::computer::{control, debug, storage0};

const TRAP_HANDLER_ADDR: u32 = 0x7000u32;

fn clear_init_handoff_info() {
    unsafe {
        ptr<i32>(0x3f20u32).store(0);
        ptr<i32>(0x3f24u32).store(0);
        ptr<i32>(0x3f28u32).store(0);
        ptr<i32>(0x3f2cu32).store(0);
        ptr<i32>(0x3f30u32).store(0);
        ptr<i32>(0x3f34u32).store(0);
    }
}

fn write_init_load_failed() {
    unsafe {
        clear_init_handoff_info();
        mmio<u8>(debug::WRITE).store(73u8);
        mmio<u8>(debug::WRITE).store(78u8);
        mmio<u8>(debug::WRITE).store(73u8);
        mmio<u8>(debug::WRITE).store(84u8);
        mmio<u8>(debug::WRITE).store(32u8);
        mmio<u8>(debug::WRITE).store(76u8);
        mmio<u8>(debug::WRITE).store(79u8);
        mmio<u8>(debug::WRITE).store(65u8);
        mmio<u8>(debug::WRITE).store(68u8);
        mmio<u8>(debug::WRITE).store(32u8);
        mmio<u8>(debug::WRITE).store(70u8);
        mmio<u8>(debug::WRITE).store(65u8);
        mmio<u8>(debug::WRITE).store(73u8);
        mmio<u8>(debug::WRITE).store(76u8);
        mmio<u8>(debug::WRITE).store(69u8);
        mmio<u8>(debug::WRITE).store(68u8);
        mmio<u8>(debug::WRITE).store(10u8);
        mmio<i32>(control::PANIC_CODE).store(73);
    }
}

fn write_kernel_boot_info_failed() {
    unsafe {
        mmio<u8>(debug::WRITE).store(75u8);
        mmio<u8>(debug::WRITE).store(69u8);
        mmio<u8>(debug::WRITE).store(82u8);
        mmio<u8>(debug::WRITE).store(78u8);
        mmio<u8>(debug::WRITE).store(69u8);
        mmio<u8>(debug::WRITE).store(76u8);
        mmio<u8>(debug::WRITE).store(32u8);
        mmio<u8>(debug::WRITE).store(66u8);
        mmio<u8>(debug::WRITE).store(79u8);
        mmio<u8>(debug::WRITE).store(79u8);
        mmio<u8>(debug::WRITE).store(84u8);
        mmio<u8>(debug::WRITE).store(32u8);
        mmio<u8>(debug::WRITE).store(73u8);
        mmio<u8>(debug::WRITE).store(78u8);
        mmio<u8>(debug::WRITE).store(70u8);
        mmio<u8>(debug::WRITE).store(79u8);
        mmio<u8>(debug::WRITE).store(32u8);
        mmio<u8>(debug::WRITE).store(70u8);
        mmio<u8>(debug::WRITE).store(65u8);
        mmio<u8>(debug::WRITE).store(73u8);
        mmio<u8>(debug::WRITE).store(76u8);
        mmio<u8>(debug::WRITE).store(69u8);
        mmio<u8>(debug::WRITE).store(68u8);
        mmio<u8>(debug::WRITE).store(10u8);
        mmio<i32>(control::PANIC_CODE).store(66);
    }
}

fn read_kernel_boot_info_root_start_lba() -> i32 {
    unsafe {
        let mut magic: i32 = ptr<i32>(0x3f00u32).load();
        if magic == 0x49424b52 {
            let mut version_and_size: i32 = ptr<i32>(0x3f04u32).load();
            if version_and_size == 0x00140001 {
                return ptr<i32>(0x3f08u32).load();
            }
        }
        return 0;
    }
}

fn write_init_handoff_info(root_start_lba: i32, init_kx_size_bytes: i32, init_entry_pc: i32) {
    unsafe {
        ptr<i32>(0x3f20u32).store(0x494e4952);
        ptr<i32>(0x3f24u32).store(0x00180001);
        ptr<i32>(0x3f28u32).store(root_start_lba);
        ptr<i32>(0x3f2cu32).store(init_kx_size_bytes);
        ptr<i32>(0x3f30u32).store(init_entry_pc);
        ptr<i32>(0x3f34u32).store(0);
    }
}

fn install_trap_handler() {
    unsafe {
        ptr<u32>(0x7000u32).store(0x0310e101u32);
        ptr<u32>(0x7004u32).store(0xe2011000u32);
        ptr<u32>(0x7008u32).store(0x00000001u32);
        ptr<u32>(0x700cu32).store(0xe1015122u32);
        ptr<u32>(0x7010u32).store(0x10000308u32);
        ptr<u32>(0x7014u32).store(0x0000e201u32);
        ptr<u32>(0x7018u32).store(0x51220000u32);
        ptr<u32>(0x701cu32).store(0x030ce101u32);
        ptr<u32>(0x7020u32).store(0xe2011000u32);
        ptr<u32>(0x7024u32).store(0x00000000u32);
        ptr<u32>(0x7028u32).store(0xe1015122u32);
        ptr<u32>(0x702cu32).store(0x10000314u32);
        ptr<u32>(0x7030u32).store(0x0049e201u32);
        ptr<u32>(0x7034u32).store(0x51220000u32);
        ptr<u32>(0x7038u32).store(0x0310e101u32);
        ptr<u32>(0x703cu32).store(0xe2011000u32);
        ptr<u32>(0x7040u32).store(0x00000002u32);
        ptr<u32>(0x7044u32).store(0xe1015122u32);
        ptr<u32>(0x7048u32).store(0x10000314u32);
        ptr<u32>(0x704cu32).store(0x004ee201u32);
        ptr<u32>(0x7050u32).store(0x51220000u32);
        ptr<u32>(0x7054u32).store(0x0310e101u32);
        ptr<u32>(0x7058u32).store(0xe2011000u32);
        ptr<u32>(0x705cu32).store(0x00000002u32);
        ptr<u32>(0x7060u32).store(0xe1015122u32);
        ptr<u32>(0x7064u32).store(0x10000314u32);
        ptr<u32>(0x7068u32).store(0x0049e201u32);
        ptr<u32>(0x706cu32).store(0x51220000u32);
        ptr<u32>(0x7070u32).store(0x0310e101u32);
        ptr<u32>(0x7074u32).store(0xe2011000u32);
        ptr<u32>(0x7078u32).store(0x00000002u32);
        ptr<u32>(0x707cu32).store(0xe1015122u32);
        ptr<u32>(0x7080u32).store(0x10000314u32);
        ptr<u32>(0x7084u32).store(0x0054e201u32);
        ptr<u32>(0x7088u32).store(0x51220000u32);
        ptr<u32>(0x708cu32).store(0x0310e101u32);
        ptr<u32>(0x7090u32).store(0xe2011000u32);
        ptr<u32>(0x7094u32).store(0x00000002u32);
        ptr<u32>(0x7098u32).store(0xe1015122u32);
        ptr<u32>(0x709cu32).store(0x10000314u32);
        ptr<u32>(0x70a0u32).store(0x0020e201u32);
        ptr<u32>(0x70a4u32).store(0x51220000u32);
        ptr<u32>(0x70a8u32).store(0x0310e101u32);
        ptr<u32>(0x70acu32).store(0xe2011000u32);
        ptr<u32>(0x70b0u32).store(0x00000002u32);
        ptr<u32>(0x70b4u32).store(0xe1015122u32);
        ptr<u32>(0x70b8u32).store(0x10000314u32);
        ptr<u32>(0x70bcu32).store(0x004fe201u32);
        ptr<u32>(0x70c0u32).store(0x51220000u32);
        ptr<u32>(0x70c4u32).store(0x0310e101u32);
        ptr<u32>(0x70c8u32).store(0xe2011000u32);
        ptr<u32>(0x70ccu32).store(0x00000002u32);
        ptr<u32>(0x70d0u32).store(0xe1015122u32);
        ptr<u32>(0x70d4u32).store(0x10000314u32);
        ptr<u32>(0x70d8u32).store(0x004be201u32);
        ptr<u32>(0x70dcu32).store(0x51220000u32);
        ptr<u32>(0x70e0u32).store(0x0310e101u32);
        ptr<u32>(0x70e4u32).store(0xe2011000u32);
        ptr<u32>(0x70e8u32).store(0x00000002u32);
        ptr<u32>(0x70ecu32).store(0xe1015122u32);
        ptr<u32>(0x70f0u32).store(0x10000004u32);
        ptr<u32>(0x70f4u32).store(0x0000e201u32);
        ptr<u32>(0x70f8u32).store(0x51220000u32);
        ptr<u32>(0x70fcu32).store(0x00000001u32);
        k16_write_csr(1u32, TRAP_HANDLER_ADDR);
    }
}

fn read_storage0_blocks(lba: i32, block_count: i32, buffer_addr: i32) -> i32 {
    unsafe {
        mmio<i32>(storage0::LBA_LOW).store(lba);
        mmio<i32>(storage0::LBA_HIGH).store(0);
        mmio<i32>(storage0::BLOCK_COUNT).store(block_count);
        mmio<i32>(storage0::BUFFER_ADDR).store(buffer_addr);
        mmio<i32>(storage0::COMMAND).store(storage0::COMMAND_READ_BLOCKS);
        return mmio<i32>(storage0::STATUS).load();
    }
}

fn probe_root_k16fs_superblock(root_start_lba: i32) -> i32 {
    unsafe {
        if root_start_lba != 0 {
            let mut status: i32 = read_storage0_blocks(root_start_lba, 1, 0x7800);
            if status == storage0::STATUS_DONE {
                let mut magic: i32 = ptr<i32>(0x7800u32).load();
                if magic == 0x4636314b {
                    let mut tail: u8 = ptr<u8>(0x7804u32).load();
                    if tail == 83u8 {
                        let mut version: u8 = ptr<u8>(0x7805u32).load();
                        if version == 1u8 {
                            return 1;
                        }
                    }
                }
            }
        }
        return 0;
    }
}

fn probe_root_k16fs_inode(root_start_lba: i32) -> i32 {
    unsafe {
        if probe_root_k16fs_superblock(root_start_lba) == 1 {
            let mut inode_table_start_block: i32 = ptr<i32>(0x7818u32).load();
            let mut root_inode_id: i32 = ptr<i32>(0x7820u32).load();
            if root_inode_id == 1 {
                let mut inode_table_lba: i32 = root_start_lba + inode_table_start_block;
                let mut status: i32 = read_storage0_blocks(inode_table_lba, 1, 0x7800);
                if status == storage0::STATUS_DONE {
                    let mut root_inode_state: u8 = ptr<u8>(0x7840u32).load();
                    if root_inode_state == 2u8 {
                        return 1;
                    }
                }
            }
        }
        return 0;
    }
}

fn find_bin_directory_inode(root_start_lba: i32) -> i32 {
    unsafe {
        if probe_root_k16fs_inode(root_start_lba) == 1 {
            let mut root_dir_start_block: i32 = ptr<i32>(0x7860u32).load();
            if root_dir_start_block != 0 {
                let mut root_dir_lba: i32 = root_start_lba + root_dir_start_block;
                let mut status: i32 = read_storage0_blocks(root_dir_lba, 1, 0x7800);
                if status == storage0::STATUS_DONE {
                    let mut index: u32 = 0u32;
                    let mut entry_addr: u32 = 0x7800u32;
                    while index < 8u32 {
                        let mut entry_state: u8 = ptr<u8>(entry_addr).load();
                        let mut name_len_addr: u32 = entry_addr + 1u32;
                        let mut name_len: u8 = ptr<u8>(name_len_addr).load();
                        if entry_state == 1u8 && name_len == 3u8 {
                            let mut name_addr: u32 = entry_addr + 8u32;
                            let mut name_magic: i32 = ptr<i32>(name_addr).load();
                            if name_magic == 0x006e6962 {
                                let mut inode_id_addr: u32 = entry_addr + 4u32;
                                return ptr<i32>(inode_id_addr).load();
                            }
                        }
                        entry_addr = entry_addr + 64u32;
                        index = index + 1u32;
                    }
                }
            }
        }
        return 0;
    }
}

fn find_init_kx_inode(root_start_lba: i32, bin_directory_inode: i32) -> i32 {
    unsafe {
        if bin_directory_inode != 0 && probe_root_k16fs_superblock(root_start_lba) == 1 {
            let mut inode_table_start_block: i32 = ptr<i32>(0x7818u32).load();
            let mut inode_table_lba: i32 = root_start_lba + inode_table_start_block;
            let mut inode_status: i32 = read_storage0_blocks(inode_table_lba, 1, 0x7800);
            if inode_status == storage0::STATUS_DONE {
                let mut inode_index: i32 = 0;
                let mut inode_addr: u32 = 0x7800u32;
                while inode_index != bin_directory_inode {
                    inode_addr = inode_addr + 64u32;
                    inode_index = inode_index + 1;
                }

                let mut bin_inode_state: u8 = ptr<u8>(inode_addr).load();
                if bin_inode_state == 2u8 {
                    let mut extent_addr: u32 = inode_addr + 32u32;
                    let mut bin_dir_start_block: i32 = ptr<i32>(extent_addr).load();
                    if bin_dir_start_block != 0 {
                        let mut bin_dir_lba: i32 = root_start_lba + bin_dir_start_block;
                        let mut dir_status: i32 = read_storage0_blocks(bin_dir_lba, 1, 0x7800);
                        if dir_status == storage0::STATUS_DONE {
                            let mut index: u32 = 0u32;
                            let mut entry_addr: u32 = 0x7800u32;
                            while index < 8u32 {
                                let mut entry_state: u8 = ptr<u8>(entry_addr).load();
                                let mut name_len_addr: u32 = entry_addr + 1u32;
                                let mut name_len: u8 = ptr<u8>(name_len_addr).load();
                                if entry_state == 1u8 && name_len == 7u8 {
                                    let mut name_addr: u32 = entry_addr + 8u32;
                                    let mut name0: i32 = ptr<i32>(name_addr).load();
                                    let mut name4_addr: u32 = name_addr + 4u32;
                                    let mut name4: i32 = ptr<i32>(name4_addr).load();
                                    if name0 == 0x74696e69 &&
                                        name4 == 0x00786b2e {
                                        let mut inode_id_addr: u32 = entry_addr + 4u32;
                                        return ptr<i32>(inode_id_addr).load();
                                    }
                                }
                                entry_addr = entry_addr + 64u32;
                                index = index + 1u32;
                            }
                        }
                    }
                }
            }
        }
        return 0;
    }
}

fn load_init_kx_from_root_k16fs(root_start_lba: i32, init_kx_inode: i32) -> i32 {
    unsafe {
        if init_kx_inode != 0 && probe_root_k16fs_superblock(root_start_lba) == 1 {
            let mut inode_table_start_block: i32 = ptr<i32>(0x7818u32).load();
            let mut inode_table_lba: i32 = root_start_lba + inode_table_start_block;
            let mut inode_status: i32 = read_storage0_blocks(inode_table_lba, 1, 0x7800);
            if inode_status == storage0::STATUS_DONE {
                let mut inode_index: i32 = 0;
                let mut inode_addr: u32 = 0x7800u32;
                while inode_index != init_kx_inode {
                    inode_addr = inode_addr + 64u32;
                    inode_index = inode_index + 1;
                }

                let mut file_state: u8 = ptr<u8>(inode_addr).load();
                if file_state == 1u8 {
                    let mut size_addr: u32 = inode_addr + 8u32;
                    let mut file_size_low: i32 = ptr<i32>(size_addr).load();
                    let mut extent_count_addr: u32 = inode_addr + 16u32;
                    let mut extent_count: u8 = ptr<u8>(extent_count_addr).load();
                    if extent_count != 0u8 {
                        let mut extent_start_addr: u32 = inode_addr + 32u32;
                        let mut init_start_block: i32 = ptr<i32>(extent_start_addr).load();
                        let mut extent_block_count_addr: u32 = inode_addr + 36u32;
                        let mut init_block_count: i32 = ptr<i32>(extent_block_count_addr).load();
                        if file_size_low != 0 && init_block_count != 0 {
                            let mut init_lba: i32 = root_start_lba + init_start_block;
                            let mut file_status: i32 = read_storage0_blocks(init_lba, init_block_count, 0xa000);
                            if file_status == storage0::STATUS_DONE {
                                let mut k16e_magic: i32 = ptr<i32>(0xa000u32).load();
                                let mut abi_kind: i32 = ptr<i32>(0xa018u32).load();
                                if k16e_magic == 0x4536314b && abi_kind == 3 {
                                    return 1;
                                }
                            }
                        }
                    }
                }
            }
        }
        return 0;
    }
}

fn execute_loaded_init_kx(root_start_lba: i32) {
    unsafe {
        let mut entry_pc: i32 = ptr<i32>(0xa00cu32).load();
        let mut section_kind: i32 = ptr<i32>(0xa020u32).load();
        let mut load_addr_i32: i32 = ptr<i32>(0xa024u32).load();
        let mut load_addr: u32 = ptr<u32>(0xa024u32).load();
        let mut payload_offset_i32: i32 = ptr<i32>(0xa028u32).load();
        let mut payload_offset: u32 = ptr<u32>(0xa028u32).load();
        let mut payload_size_i32: i32 = ptr<i32>(0xa02cu32).load();
        let mut payload_size: u32 = ptr<u32>(0xa02cu32).load();
        let mut memory_size_i32: i32 = ptr<i32>(0xa030u32).load();

        if load_addr < 0x8000u32 {
            write_init_load_failed();
            return;
        }

        if entry_pc != 0 &&
            section_kind == 1 &&
            load_addr_i32 != 0 &&
            payload_offset_i32 != 0 &&
            payload_size_i32 != 0 &&
            memory_size_i32 == payload_size_i32 {
            let mut copied: u32 = 0u32;
            let mut source_addr: u32 = 0xa000u32 + payload_offset;
            let mut dest_addr: u32 = load_addr;
            while copied < payload_size {
                let mut byte: u8 = ptr<u8>(source_addr).load();
                ptr<u8>(dest_addr).store(byte);
                source_addr = source_addr + 1u32;
                dest_addr = dest_addr + 1u32;
                copied = copied + 1u32;
            }
            let mut init_kx_size_bytes: i32 = payload_offset_i32 + payload_size_i32;
            write_init_handoff_info(root_start_lba, init_kx_size_bytes, entry_pc);
            install_trap_handler();
            k16_jump(entry_pc);
        }

        write_init_load_failed();
    }
}

fn load_init() {
    unsafe {
        let mut root_start_lba: i32 = read_kernel_boot_info_root_start_lba();
        if root_start_lba == 0 {
            write_kernel_boot_info_failed();
            return;
        }
        let mut bin_directory_inode: i32 = find_bin_directory_inode(root_start_lba);
        let mut init_kx_inode: i32 = find_init_kx_inode(
            root_start_lba,
            bin_directory_inode
        );
        let mut init_kx_present: i32 = load_init_kx_from_root_k16fs(
            root_start_lba,
            init_kx_inode
        );
        if init_kx_present == 1 {
            execute_loaded_init_kx(root_start_lba);
        } else {
            write_init_load_failed();
        }
    }
}

fn main() {
    load_init();
}
