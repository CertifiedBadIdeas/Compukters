fn write(ch: u8) {
    unsafe {
        mmio<u8>(DEBUG_WRITE).store(ch);
    }
}

fn main() -> i32 {
    unsafe {
        mmio<i32>(CONTROL_STATUS).store(STATUS_BOOTING);
    }

    let mut i: u32 = 0u32;
    while i < 9u32 {
        write(b"RUX READY"[i]);
        i += 1u32;
    }

    unsafe {
        mmio<i32>(CONTROL_STATUS).store(STATUS_READY);
    }

    return 0;
}
