use rux::abi::computer::{control, debug, storage0};

fn write_kernel_load_failed() {
    unsafe {
        mmio<u8>(debug::WRITE).store(75u8);
        mmio<u8>(debug::WRITE).store(69u8);
        mmio<u8>(debug::WRITE).store(82u8);
        mmio<u8>(debug::WRITE).store(78u8);
        mmio<u8>(debug::WRITE).store(69u8);
        mmio<u8>(debug::WRITE).store(76u8);
        mmio<u8>(debug::WRITE).store(32u8);
        mmio<u8>(debug::WRITE).store(76u8);
        mmio<u8>(debug::WRITE).store(79u8);
        mmio<u8>(debug::WRITE).store(65u8);
        mmio<u8>(debug::WRITE).store(68u8);
        mmio<u8>(debug::WRITE).store(32u8);
        mmio<u8>(debug::WRITE).store(70u8);
        mmio<u8>(debug::WRITE).store(65u8);
        mmio<u8>(debug::WRITE).store(73u8);
        mmio<u8>(debug::WRITE).store(76u8);
        mmio<u8>(debug::WRITE).store(69u8);
        mmio<u8>(debug::WRITE).store(68u8);
        mmio<u8>(debug::WRITE).store(10u8);
        mmio<i32>(control::PANIC_CODE).store(69);
    }
}

fn write_kernel_boot_info(root_start_lba: i32, kernel_kx_size_bytes: i32) {
    unsafe {
        ptr<i32>(0x3f00u32).store(0x49424b52);
        ptr<i32>(0x3f04u32).store(0x00140001);
        ptr<i32>(0x3f08u32).store(root_start_lba);
        ptr<i32>(0x3f0cu32).store(kernel_kx_size_bytes);
        ptr<i32>(0x3f10u32).store(0);
    }
}

fn read_storage0_blocks(lba: i32, block_count: i32, buffer_addr: i32) -> i32 {
    unsafe {
        mmio<i32>(storage0::LBA_LOW).store(lba);
        mmio<i32>(storage0::LBA_HIGH).store(0);
        mmio<i32>(storage0::BLOCK_COUNT).store(block_count);
        mmio<i32>(storage0::BUFFER_ADDR).store(buffer_addr);
        mmio<i32>(storage0::COMMAND).store(storage0::COMMAND_READ_BLOCKS);
        return mmio<i32>(storage0::STATUS).load();
    }
}

fn probe_k16pt_header() -> i32 {
    unsafe {
        let mut status: i32 = read_storage0_blocks(0, 1, 0x3000);
        if status == storage0::STATUS_DONE {
            let mut magic: i32 = ptr<i32>(0x3000u32).load();
            if magic == 0x5036314b {
                let mut tail: u8 = ptr<u8>(0x3004u32).load();
                if tail == 84u8 {
                    let mut version: u8 = ptr<u8>(0x3005u32).load();
                    if version == 1u8 {
                        return 1;
                    }
                }
            }
        }
        return 0;
    }
}

fn find_root_partition_start_lba() -> i32 {
    unsafe {
        if probe_k16pt_header() == 1 {
            let mut entry_count: u8 = ptr<u8>(0x3006u32).load();
            let mut index: u32 = 0u32;
            let mut entry_addr: u32 = 0x3010u32;
            while index < 15u32 {
                let mut partition_type: i32 = ptr<i32>(entry_addr).load();
                if partition_type == 0x544f4f52 {
                    let mut start_lba_addr: u32 = entry_addr + 8u32;
                    return ptr<i32>(start_lba_addr).load();
                }
                entry_addr = entry_addr + 32u32;
                index = index + 1u32;
            }
        }
        return 0;
    }
}

fn probe_root_k16fs_superblock(root_start_lba: i32) -> i32 {
    unsafe {
        if root_start_lba != 0 {
            let mut status: i32 = read_storage0_blocks(root_start_lba, 1, 0x3000);
            if status == storage0::STATUS_DONE {
                let mut magic: i32 = ptr<i32>(0x3000u32).load();
                if magic == 0x4636314b {
                    let mut tail: u8 = ptr<u8>(0x3004u32).load();
                    if tail == 83u8 {
                        let mut version: u8 = ptr<u8>(0x3005u32).load();
                        if version == 1u8 {
                            return 1;
                        }
                    }
                }
            }
        }
        return 0;
    }
}

fn probe_root_k16fs_inode(root_start_lba: i32) -> i32 {
    unsafe {
        if probe_root_k16fs_superblock(root_start_lba) == 1 {
            let mut inode_table_start_block: i32 = ptr<i32>(0x3018u32).load();
            let mut root_inode_id: i32 = ptr<i32>(0x3020u32).load();
            if root_inode_id == 1 {
                let mut inode_table_lba: i32 = root_start_lba + inode_table_start_block;
                let mut status: i32 = read_storage0_blocks(inode_table_lba, 1, 0x3000);
                if status == storage0::STATUS_DONE {
                    let mut root_inode_state: u8 = ptr<u8>(0x3040u32).load();
                    if root_inode_state == 2u8 {
                        return 1;
                    }
                }
            }
        }
        return 0;
    }
}

fn find_boot_directory_inode(root_start_lba: i32) -> i32 {
    unsafe {
        if probe_root_k16fs_inode(root_start_lba) == 1 {
            let mut root_dir_start_block: i32 = ptr<i32>(0x3060u32).load();
            if root_dir_start_block != 0 {
                let mut root_dir_lba: i32 = root_start_lba + root_dir_start_block;
                let mut status: i32 = read_storage0_blocks(root_dir_lba, 1, 0x3000);
                if status == storage0::STATUS_DONE {
                    let mut index: u32 = 0u32;
                    let mut entry_addr: u32 = 0x3000u32;
                    while index < 8u32 {
                        let mut entry_state: u8 = ptr<u8>(entry_addr).load();
                        let mut name_len_addr: u32 = entry_addr + 1u32;
                        let mut name_len: u8 = ptr<u8>(name_len_addr).load();
                        if entry_state == 1u8 && name_len == 4u8 {
                            let mut name_addr: u32 = entry_addr + 8u32;
                            let mut name_magic: i32 = ptr<i32>(name_addr).load();
                            if name_magic == 0x746f6f62 {
                                let mut inode_id_addr: u32 = entry_addr + 4u32;
                                return ptr<i32>(inode_id_addr).load();
                            }
                        }
                        entry_addr = entry_addr + 64u32;
                        index = index + 1u32;
                    }
                }
            }
        }
        return 0;
    }
}

fn find_kernel_kx_inode(root_start_lba: i32, boot_directory_inode: i32) -> i32 {
    unsafe {
        if boot_directory_inode != 0 && probe_root_k16fs_superblock(root_start_lba) == 1 {
            let mut inode_table_start_block: i32 = ptr<i32>(0x3018u32).load();
            let mut inode_table_lba: i32 = root_start_lba + inode_table_start_block;
            let mut inode_status: i32 = read_storage0_blocks(inode_table_lba, 1, 0x3000);
            if inode_status == storage0::STATUS_DONE {
                let mut inode_index: i32 = 0;
                let mut inode_addr: u32 = 0x3000u32;
                while inode_index != boot_directory_inode {
                    inode_addr = inode_addr + 64u32;
                    inode_index = inode_index + 1;
                }

                let mut boot_inode_state: u8 = ptr<u8>(inode_addr).load();
                if boot_inode_state == 2u8 {
                    let mut extent_addr: u32 = inode_addr + 32u32;
                    let mut boot_dir_start_block: i32 = ptr<i32>(extent_addr).load();
                    if boot_dir_start_block != 0 {
                        let mut boot_dir_lba: i32 = root_start_lba + boot_dir_start_block;
                        let mut dir_status: i32 = read_storage0_blocks(boot_dir_lba, 1, 0x3000);
                        if dir_status == storage0::STATUS_DONE {
                            let mut index: u32 = 0u32;
                            let mut entry_addr: u32 = 0x3000u32;
                            while index < 8u32 {
                                let mut entry_state: u8 = ptr<u8>(entry_addr).load();
                                let mut name_len_addr: u32 = entry_addr + 1u32;
                                let mut name_len: u8 = ptr<u8>(name_len_addr).load();
                                if entry_state == 1u8 && name_len == 9u8 {
                                    let mut name_addr: u32 = entry_addr + 8u32;
                                    let mut name0: i32 = ptr<i32>(name_addr).load();
                                    let mut name4_addr: u32 = name_addr + 4u32;
                                    let mut name4: i32 = ptr<i32>(name4_addr).load();
                                    let mut name8_addr: u32 = name_addr + 8u32;
                                    let mut name8: i32 = ptr<i32>(name8_addr).load();
                                    if name0 == 0x6e72656b &&
                                        name4 == 0x6b2e6c65 &&
                                        name8 == 0x00000078 {
                                        let mut inode_id_addr: u32 = entry_addr + 4u32;
                                        return ptr<i32>(inode_id_addr).load();
                                    }
                                }
                                entry_addr = entry_addr + 64u32;
                                index = index + 1u32;
                            }
                        }
                    }
                }
            }
        }
        return 0;
    }
}

fn probe_kernel_kx_inode_metadata(root_start_lba: i32, kernel_kx_inode: i32) -> i32 {
    unsafe {
        return load_kernel_kx_from_root_k16fs(root_start_lba, kernel_kx_inode);
    }
}

fn load_kernel_kx_from_root_k16fs(root_start_lba: i32, kernel_kx_inode: i32) -> i32 {
    unsafe {
        if kernel_kx_inode != 0 && probe_root_k16fs_superblock(root_start_lba) == 1 {
            let mut inode_table_start_block: i32 = ptr<i32>(0x3018u32).load();
            let mut inode_table_lba: i32 = root_start_lba + inode_table_start_block;
            let mut inode_status: i32 = read_storage0_blocks(inode_table_lba, 1, 0x3000);
            if inode_status == storage0::STATUS_DONE {
                let mut inode_index: i32 = 0;
                let mut inode_addr: u32 = 0x3000u32;
                while inode_index != kernel_kx_inode {
                    inode_addr = inode_addr + 64u32;
                    inode_index = inode_index + 1;
                }

                let mut file_state: u8 = ptr<u8>(inode_addr).load();
                if file_state == 1u8 {
                    let mut size_addr: u32 = inode_addr + 8u32;
                    let mut file_size_low: i32 = ptr<i32>(size_addr).load();
                    let mut extent_count_addr: u32 = inode_addr + 16u32;
                    let mut extent_count: u8 = ptr<u8>(extent_count_addr).load();
                    if extent_count != 0u8 {
                        let mut extent_start_addr: u32 = inode_addr + 32u32;
                        let mut kernel_start_block: i32 = ptr<i32>(extent_start_addr).load();
                        let mut extent_block_count_addr: u32 = inode_addr + 36u32;
                        let mut kernel_block_count: i32 = ptr<i32>(extent_block_count_addr).load();
                        if file_size_low != 0 && kernel_block_count != 0 {
                            let mut kernel_lba: i32 = root_start_lba + kernel_start_block;
                            let mut file_status: i32 = read_storage0_blocks(kernel_lba, kernel_block_count, 0x6000);
                            if file_status == storage0::STATUS_DONE {
                                let mut k16e_magic: i32 = ptr<i32>(0x6000u32).load();
                                if k16e_magic == 0x4536314b {
                                    return 1;
                                }
                            }
                        }
                    }
                }
            }
        }
        return 0;
    }
}

fn execute_loaded_kernel_kx(root_start_lba: i32) {
    unsafe {
        let mut entry_pc: i32 = ptr<i32>(0x600cu32).load();
        let mut section_kind: i32 = ptr<i32>(0x6020u32).load();
        let mut load_addr_i32: i32 = ptr<i32>(0x6024u32).load();
        let mut load_addr: u32 = ptr<u32>(0x6024u32).load();
        let mut payload_offset_i32: i32 = ptr<i32>(0x6028u32).load();
        let mut payload_offset: u32 = ptr<u32>(0x6028u32).load();
        let mut payload_size_i32: i32 = ptr<i32>(0x602cu32).load();
        let mut payload_size: u32 = ptr<u32>(0x602cu32).load();
        let mut memory_size_i32: i32 = ptr<i32>(0x6030u32).load();

        if entry_pc != 0 &&
            section_kind == 1 &&
            load_addr_i32 != 0 &&
            payload_offset_i32 != 0 &&
            payload_size_i32 != 0 &&
            memory_size_i32 == payload_size_i32 {
            let mut kernel_kx_size_bytes: i32 = payload_offset_i32 + payload_size_i32;
            write_kernel_boot_info(root_start_lba, kernel_kx_size_bytes);
            let mut copied: u32 = 0u32;
            let mut source_addr: u32 = 0x6000u32 + payload_offset;
            let mut dest_addr: u32 = load_addr;
            while copied < payload_size {
                let mut byte: u8 = ptr<u8>(source_addr).load();
                ptr<u8>(dest_addr).store(byte);
                source_addr = source_addr + 1u32;
                dest_addr = dest_addr + 1u32;
                copied = copied + 1u32;
            }
            k16_jump(entry_pc);
        }

        write_kernel_load_failed();
    }
}

fn load_kernel() {
    unsafe {
        let mut root_start_lba: i32 = find_root_partition_start_lba();
        let mut boot_directory_inode: i32 = find_boot_directory_inode(root_start_lba);
        let mut kernel_kx_inode: i32 = find_kernel_kx_inode(
            root_start_lba,
            boot_directory_inode
        );
        let mut kernel_kx_metadata_present: i32 = probe_kernel_kx_inode_metadata(
            root_start_lba,
            kernel_kx_inode
        );
        if kernel_kx_metadata_present == 1 {
            execute_loaded_kernel_kx(root_start_lba);
        } else {
            write_kernel_load_failed();
        }
    }
}

fn main() {
    load_kernel();
}
