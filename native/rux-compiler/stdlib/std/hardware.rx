pub fn boot_magic() -> u32 {
    unsafe {
        return ptr<u32>(RAM_BASE + 0).load();
    }
}

pub fn profile_version() -> u32 {
    unsafe {
        return ptr<u32>(RAM_BASE + 4).load();
    }
}

pub fn ram_size() -> u32 {
    unsafe {
        return ptr<u32>(RAM_BASE + 8).load();
    }
}

pub fn page_size() -> u32 {
    unsafe {
        return ptr<u32>(RAM_BASE + 12).load();
    }
}

pub fn program_base() -> u32 {
    unsafe {
        return ptr<u32>(RAM_BASE + 16).load();
    }
}

pub fn hardware_table_addr() -> u32 {
    unsafe {
        return ptr<u32>(RAM_BASE + 20).load();
    }
}

pub fn hardware_count() -> u32 {
    unsafe {
        return ptr<u32>(RAM_BASE + 24).load();
    }
}

pub fn find_mmio_base(id: u32) -> u32 {
    let mut table: u32 = 0u32;
    let mut count: u32 = 0u32;
    unsafe {
        table = ptr<u32>(RAM_BASE + 20).load();
        count = ptr<u32>(RAM_BASE + 24).load();
    }

    let mut i: u32 = 0u32;
    while i < count {
        let mut entry: u32 = table + i * 12u32;
        unsafe {
            if ptr<u32>(entry).load() == id {
                return ptr<u32>(entry + 4).load();
            }
        }
        i += 1u32;
    }

    return 0u32;
}

pub fn find_mmio_size(id: u32) -> u32 {
    let mut table: u32 = 0u32;
    let mut count: u32 = 0u32;
    unsafe {
        table = ptr<u32>(RAM_BASE + 20).load();
        count = ptr<u32>(RAM_BASE + 24).load();
    }

    let mut i: u32 = 0u32;
    while i < count {
        let mut entry: u32 = table + i * 12u32;
        unsafe {
            if ptr<u32>(entry).load() == id {
                return ptr<u32>(entry + 8).load();
            }
        }
        i += 1u32;
    }

    return 0u32;
}
