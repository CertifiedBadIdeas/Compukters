pub fn base() -> u32 {
    let mut table: u32 = 0u32;
    let mut count: u32 = 0u32;
    unsafe {
        table = ptr<u32>(RAM_BASE + 20).load();
        count = ptr<u32>(RAM_BASE + 24).load();
    }

    let mut i: u32 = 0u32;
    while i < count {
        let mut entry: u32 = table + i * 12u32;
        unsafe {
            if ptr<u32>(entry).load() == 4u32 {
                return ptr<u32>(entry + 4).load();
            }
        }
        i += 1u32;
    }

    return 0u32;
}

pub fn columns() -> u32 {
    let mut table: u32 = 0u32;
    let mut count: u32 = 0u32;
    unsafe {
        table = ptr<u32>(RAM_BASE + 20).load();
        count = ptr<u32>(RAM_BASE + 24).load();
    }

    let mut base: u32 = 0u32;
    let mut i: u32 = 0u32;
    while i < count {
        let mut entry: u32 = table + i * 12u32;
        unsafe {
            if ptr<u32>(entry).load() == 4u32 {
                base = ptr<u32>(entry + 4).load();
            }
        }
        i += 1u32;
    }

    if base == 0u32 {
        return 0u32;
    }

    unsafe {
        return mmio<i32>(base).load() as u32;
    }
}

pub fn rows() -> u32 {
    let mut table: u32 = 0u32;
    let mut count: u32 = 0u32;
    unsafe {
        table = ptr<u32>(RAM_BASE + 20).load();
        count = ptr<u32>(RAM_BASE + 24).load();
