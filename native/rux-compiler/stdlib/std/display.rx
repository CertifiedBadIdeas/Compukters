    while i < count {
        let mut entry: u32 = table + i * 12u32;
        unsafe {
            if ptr<u32>(entry).load() == 4u32 {
                base = ptr<u32>(entry + 4).load();
            }
        }
        i += 1u32;
    }

    if base == 0u32 {
        return 0u32;
    }

    unsafe {
