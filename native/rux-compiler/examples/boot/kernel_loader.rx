use rux::abi::computer::{control, debug, storage0};

fn write_kernel_load_failed() {
    unsafe {
        mmio<u8>(debug::WRITE).store(75u8);
        mmio<u8>(debug::WRITE).store(69u8);
        mmio<u8>(debug::WRITE).store(82u8);
        mmio<u8>(debug::WRITE).store(78u8);
        mmio<u8>(debug::WRITE).store(69u8);
        mmio<u8>(debug::WRITE).store(76u8);
        mmio<u8>(debug::WRITE).store(32u8);
        mmio<u8>(debug::WRITE).store(76u8);
        mmio<u8>(debug::WRITE).store(79u8);
        mmio<u8>(debug::WRITE).store(65u8);
        mmio<u8>(debug::WRITE).store(68u8);
        mmio<u8>(debug::WRITE).store(32u8);
        mmio<u8>(debug::WRITE).store(70u8);
        mmio<u8>(debug::WRITE).store(65u8);
        mmio<u8>(debug::WRITE).store(73u8);
        mmio<u8>(debug::WRITE).store(76u8);
        mmio<u8>(debug::WRITE).store(69u8);
        mmio<u8>(debug::WRITE).store(68u8);
        mmio<u8>(debug::WRITE).store(10u8);
        mmio<i32>(control::PANIC_CODE).store(69);
    }
}

fn read_storage0_blocks(lba: i32, block_count: i32, buffer_addr: i32) -> i32 {
    unsafe {
        mmio<i32>(storage0::LBA_LOW).store(lba);
        mmio<i32>(storage0::LBA_HIGH).store(0);
        mmio<i32>(storage0::BLOCK_COUNT).store(block_count);
        mmio<i32>(storage0::BUFFER_ADDR).store(buffer_addr);
        mmio<i32>(storage0::COMMAND).store(storage0::COMMAND_READ_BLOCKS);
        return mmio<i32>(storage0::STATUS).load();
    }
}

fn probe_ruxpt_header() -> i32 {
    unsafe {
        let mut status: i32 = read_storage0_blocks(0, 1, 0x3000);
        if status == storage0::STATUS_DONE {
            let mut magic: i32 = ptr<i32>(0x3000u32).load();
            if magic == 0x50585552 {
                let mut tail: u8 = ptr<u8>(0x3004u32).load();
                if tail == 84u8 {
                    let mut version: u8 = ptr<u8>(0x3005u32).load();
                    if version == 1u8 {
                        return 1;
                    }
                }
            }
        }
        return 0;
    }
}

fn load_kernel() {
    unsafe {
        let mut ruxpt_present: i32 = probe_ruxpt_header();
        let mut status: i32 = read_storage0_blocks(16, 1, 0x3000);
        if status == storage0::STATUS_DONE {
            let mut magic: i32 = ptr<i32>(0x3000u32).load();
            if magic == 0x4b585552 {
                let mut entry_pc: i32 = ptr<i32>(0x3004u32).load();
                let mut load_addr: i32 = ptr<i32>(0x3008u32).load();
                let mut block_count: i32 = ptr<i32>(0x300cu32).load();
                let mut start_lba: i32 = ptr<i32>(0x3010u32).load();

                if entry_pc == 0 {
                    write_kernel_load_failed();
                } else {
                    if load_addr == 0 {
                        write_kernel_load_failed();
                    } else {
                        if block_count == 0 {
                            write_kernel_load_failed();
                        } else {
                            if start_lba == 0 {
                                write_kernel_load_failed();
                            } else {
                                let mut payload_status: i32 = read_storage0_blocks(
                                    start_lba,
                                    block_count,
                                    load_addr
                                );
                                if payload_status == storage0::STATUS_DONE {
                                    rux16_jump(entry_pc);
                                } else {
                                    write_kernel_load_failed();
                                }
                            }
                        }
                    }
                }
            } else {
                write_kernel_load_failed();
            }
        } else {
            write_kernel_load_failed();
        }
    }
}

fn main() {
    load_kernel();
}
