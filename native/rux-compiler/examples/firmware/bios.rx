use std::computer::{set_booting, set_ready};
use std::display::{clear, set_cursor, write_bytes};
use std::hardware::find_mmio_base;
use std::io::write_byte;

fn debug_line(bytes: ptr<u8>, len: u32) {
    let mut i: u32 = 0u32;
    while i < len {
        unsafe {
            write_byte(bytes[i]);
        }
        i += 1u32;
    }
    write_byte(10u8);
}

fn display_line(row: u32, bytes: ptr<u8>, len: u32) {
    set_cursor(0u32, row);
    write_bytes(bytes, len);
}

fn storage_media_status() -> i32 {
    let mut storage_base: u32 = find_mmio_base(5u32);
    if storage_base == 0u32 {
        return 0;
    }

    unsafe {
        return mmio<i32>(storage_base + 56).load();
    }
}

fn main() {
    set_booting();

    clear();
    display_line(0u32, b"RUX BIOS v1", 11u32);
    display_line(1u32, b"Compukter Kraft", 15u32);
    display_line(3u32, b"BootInfo OK", 11u32);

    debug_line(b"RUX BIOS", 8u32);
    debug_line(b"BOOTINFO OK", 11u32);

    let mut media: i32 = storage_media_status();
    if media == 1 || media == 2 {
        display_line(4u32, b"Storage: present", 16u32);
        debug_line(b"HW STORAGE0 PRESENT", 19u32);
    } else {
        display_line(4u32, b"Storage: absent", 15u32);
        debug_line(b"HW STORAGE0 ABSENT", 18u32);
    }

    display_line(5u32, b"No bootable device", 18u32);
    debug_line(b"NO BOOTABLE DEVICE", 18u32);

    set_ready();

    while true {
    }
}
