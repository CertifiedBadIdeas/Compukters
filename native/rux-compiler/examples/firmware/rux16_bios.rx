use rux::abi::computer::{control, debug, display0, status, storage0};

fn write_banner() {
    unsafe {
        mmio<u8>(debug::WRITE).store(82u8);
        mmio<u8>(debug::WRITE).store(85u8);
        mmio<u8>(debug::WRITE).store(88u8);
        mmio<u8>(debug::WRITE).store(49u8);
        mmio<u8>(debug::WRITE).store(54u8);
        mmio<u8>(debug::WRITE).store(32u8);
        mmio<u8>(debug::WRITE).store(66u8);
        mmio<u8>(debug::WRITE).store(73u8);
        mmio<u8>(debug::WRITE).store(79u8);
        mmio<u8>(debug::WRITE).store(83u8);
        mmio<u8>(debug::WRITE).store(10u8);
    }
}

fn draw_banner() {
    unsafe {
        mmio<i32>(display0::COMMAND).store(display0::COMMAND_CLEAR);
        mmio<i32>(display0::CURSOR_X).store(0);
        mmio<i32>(display0::CURSOR_Y).store(0);
        mmio<i32>(display0::DATA).store(82);
        mmio<i32>(display0::COMMAND).store(display0::COMMAND_PUT_BYTE_AT_CURSOR);
        mmio<i32>(display0::DATA).store(85);
        mmio<i32>(display0::COMMAND).store(display0::COMMAND_PUT_BYTE_AT_CURSOR);
        mmio<i32>(display0::DATA).store(88);
        mmio<i32>(display0::COMMAND).store(display0::COMMAND_PUT_BYTE_AT_CURSOR);
        mmio<i32>(display0::DATA).store(49);
        mmio<i32>(display0::COMMAND).store(display0::COMMAND_PUT_BYTE_AT_CURSOR);
        mmio<i32>(display0::DATA).store(54);
        mmio<i32>(display0::COMMAND).store(display0::COMMAND_PUT_BYTE_AT_CURSOR);
        mmio<i32>(display0::DATA).store(32);
        mmio<i32>(display0::COMMAND).store(display0::COMMAND_PUT_BYTE_AT_CURSOR);
        mmio<i32>(display0::DATA).store(66);
        mmio<i32>(display0::COMMAND).store(display0::COMMAND_PUT_BYTE_AT_CURSOR);
        mmio<i32>(display0::DATA).store(73);
        mmio<i32>(display0::COMMAND).store(display0::COMMAND_PUT_BYTE_AT_CURSOR);
        mmio<i32>(display0::DATA).store(79);
        mmio<i32>(display0::COMMAND).store(display0::COMMAND_PUT_BYTE_AT_CURSOR);
        mmio<i32>(display0::DATA).store(83);
        mmio<i32>(display0::COMMAND).store(display0::COMMAND_PUT_BYTE_AT_CURSOR);
    }
}

fn write_no_bootable_device() {
