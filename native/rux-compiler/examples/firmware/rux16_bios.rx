use rux::abi::computer::{
    CONTROL_PANIC_CODE, CONTROL_STATUS, DEBUG_WRITE, DISPLAY0_COMMAND, DISPLAY0_COMMAND_CLEAR,
    DISPLAY0_COMMAND_PUT_BYTE_AT_CURSOR, DISPLAY0_CURSOR_X, DISPLAY0_CURSOR_Y, DISPLAY0_DATA,
    STATUS_BOOTING, STATUS_READY, STORAGE0_BLOCK_COUNT, STORAGE0_BUFFER_ADDR, STORAGE0_COMMAND,
    STORAGE0_LBA_HIGH, STORAGE0_LBA_LOW, STORAGE0_STATUS, STORAGE_COMMAND_READ_BLOCKS,
    STORAGE_STATUS_DONE
};

fn write_banner() {
    unsafe {
        mmio<u8>(DEBUG_WRITE).store(82u8);
        mmio<u8>(DEBUG_WRITE).store(85u8);
        mmio<u8>(DEBUG_WRITE).store(88u8);
        mmio<u8>(DEBUG_WRITE).store(49u8);
        mmio<u8>(DEBUG_WRITE).store(54u8);
        mmio<u8>(DEBUG_WRITE).store(32u8);
        mmio<u8>(DEBUG_WRITE).store(66u8);
        mmio<u8>(DEBUG_WRITE).store(73u8);
        mmio<u8>(DEBUG_WRITE).store(79u8);
        mmio<u8>(DEBUG_WRITE).store(83u8);
        mmio<u8>(DEBUG_WRITE).store(10u8);
    }
}

fn draw_banner() {
    unsafe {
        mmio<i32>(DISPLAY0_COMMAND).store(DISPLAY0_COMMAND_CLEAR);
        mmio<i32>(DISPLAY0_CURSOR_X).store(0);
        mmio<i32>(DISPLAY0_CURSOR_Y).store(0);
        mmio<i32>(DISPLAY0_DATA).store(82);
        mmio<i32>(DISPLAY0_COMMAND).store(DISPLAY0_COMMAND_PUT_BYTE_AT_CURSOR);
        mmio<i32>(DISPLAY0_DATA).store(85);
        mmio<i32>(DISPLAY0_COMMAND).store(DISPLAY0_COMMAND_PUT_BYTE_AT_CURSOR);
        mmio<i32>(DISPLAY0_DATA).store(88);
        mmio<i32>(DISPLAY0_COMMAND).store(DISPLAY0_COMMAND_PUT_BYTE_AT_CURSOR);
        mmio<i32>(DISPLAY0_DATA).store(49);
        mmio<i32>(DISPLAY0_COMMAND).store(DISPLAY0_COMMAND_PUT_BYTE_AT_CURSOR);
        mmio<i32>(DISPLAY0_DATA).store(54);
        mmio<i32>(DISPLAY0_COMMAND).store(DISPLAY0_COMMAND_PUT_BYTE_AT_CURSOR);
        mmio<i32>(DISPLAY0_DATA).store(32);
        mmio<i32>(DISPLAY0_COMMAND).store(DISPLAY0_COMMAND_PUT_BYTE_AT_CURSOR);
        mmio<i32>(DISPLAY0_DATA).store(66);
        mmio<i32>(DISPLAY0_COMMAND).store(DISPLAY0_COMMAND_PUT_BYTE_AT_CURSOR);
        mmio<i32>(DISPLAY0_DATA).store(73);
        mmio<i32>(DISPLAY0_COMMAND).store(DISPLAY0_COMMAND_PUT_BYTE_AT_CURSOR);
        mmio<i32>(DISPLAY0_DATA).store(79);
        mmio<i32>(DISPLAY0_COMMAND).store(DISPLAY0_COMMAND_PUT_BYTE_AT_CURSOR);
        mmio<i32>(DISPLAY0_DATA).store(83);
        mmio<i32>(DISPLAY0_COMMAND).store(DISPLAY0_COMMAND_PUT_BYTE_AT_CURSOR);
    }
}

fn write_no_bootable_device() {
    unsafe {
        mmio<u8>(DEBUG_WRITE).store(78u8);
        mmio<u8>(DEBUG_WRITE).store(79u8);
        mmio<u8>(DEBUG_WRITE).store(32u8);
        mmio<u8>(DEBUG_WRITE).store(66u8);
        mmio<u8>(DEBUG_WRITE).store(79u8);
        mmio<u8>(DEBUG_WRITE).store(79u8);
        mmio<u8>(DEBUG_WRITE).store(84u8);
        mmio<u8>(DEBUG_WRITE).store(65u8);
        mmio<u8>(DEBUG_WRITE).store(66u8);
        mmio<u8>(DEBUG_WRITE).store(76u8);
        mmio<u8>(DEBUG_WRITE).store(69u8);
        mmio<u8>(DEBUG_WRITE).store(32u8);
        mmio<u8>(DEBUG_WRITE).store(68u8);
        mmio<u8>(DEBUG_WRITE).store(69u8);
        mmio<u8>(DEBUG_WRITE).store(86u8);
        mmio<u8>(DEBUG_WRITE).store(73u8);
        mmio<u8>(DEBUG_WRITE).store(67u8);
        mmio<u8>(DEBUG_WRITE).store(69u8);
        mmio<u8>(DEBUG_WRITE).store(10u8);
    }
    draw_no_bootable_device();
}

