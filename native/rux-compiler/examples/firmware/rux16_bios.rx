fn write_boot_payload_loaded() {
    unsafe {
        mmio<u8>(DEBUG_WRITE).store(66u8);
        mmio<u8>(DEBUG_WRITE).store(79u8);
        mmio<u8>(DEBUG_WRITE).store(79u8);
        mmio<u8>(DEBUG_WRITE).store(84u8);
        mmio<u8>(DEBUG_WRITE).store(32u8);
        mmio<u8>(DEBUG_WRITE).store(80u8);
        mmio<u8>(DEBUG_WRITE).store(65u8);
        mmio<u8>(DEBUG_WRITE).store(89u8);
        mmio<u8>(DEBUG_WRITE).store(76u8);
        mmio<u8>(DEBUG_WRITE).store(79u8);
        mmio<u8>(DEBUG_WRITE).store(65u8);
        mmio<u8>(DEBUG_WRITE).store(68u8);
        mmio<u8>(DEBUG_WRITE).store(32u8);
        mmio<u8>(DEBUG_WRITE).store(76u8);
        mmio<u8>(DEBUG_WRITE).store(79u8);
        mmio<u8>(DEBUG_WRITE).store(65u8);
        mmio<u8>(DEBUG_WRITE).store(68u8);
        mmio<u8>(DEBUG_WRITE).store(69u8);
        mmio<u8>(DEBUG_WRITE).store(68u8);
        mmio<u8>(DEBUG_WRITE).store(10u8);
    }
}

fn load_boot_payload() {
    unsafe {
        let mut entry_pc: i32 = ptr<i32>(516u32).load();
        let mut load_addr: i32 = ptr<i32>(520u32).load();
        let mut block_count: i32 = ptr<i32>(524u32).load();
        let mut start_lba: i32 = ptr<i32>(528u32).load();

        if block_count != 0 {
            mmio<i32>(STORAGE0_LBA_LOW).store(start_lba);
            mmio<i32>(STORAGE0_LBA_HIGH).store(0);
            mmio<i32>(STORAGE0_BLOCK_COUNT).store(block_count);
            mmio<i32>(STORAGE0_BUFFER_ADDR).store(load_addr);
            mmio<i32>(STORAGE0_COMMAND).store(STORAGE_COMMAND_READ_BLOCKS);

            let mut status: i32 = mmio<i32>(STORAGE0_STATUS).load();
            if status == STORAGE_STATUS_DONE {
                write_boot_payload_loaded();
            } else {
                write_no_bootable_device();
            }
        }
    }
}

fn discover_boot_record() {
    unsafe {
        mmio<i32>(STORAGE0_LBA_LOW).store(0);
        mmio<i32>(STORAGE0_LBA_HIGH).store(0);
        mmio<i32>(STORAGE0_BLOCK_COUNT).store(1);
        mmio<i32>(STORAGE0_BUFFER_ADDR).store(512);
        mmio<i32>(STORAGE0_COMMAND).store(STORAGE_COMMAND_READ_BLOCKS);

        let mut status: i32 = mmio<i32>(STORAGE0_STATUS).load();
        if status == STORAGE_STATUS_DONE {
            let mut magic: i32 = ptr<i32>(512u32).load();
            if magic == 1113085266 {
                write_boot_record_found();
                load_boot_payload();
            } else {
                write_no_bootable_device();
            }
        } else {
            write_no_bootable_device();
        }
    }
}

fn main() {
    unsafe {
        mmio<i32>(CONTROL_STATUS).store(STATUS_BOOTING);
    }

    write_banner();
    discover_boot_record();

    unsafe {
        mmio<i32>(CONTROL_PANIC_CODE).store(STATUS_READY);
        mmio<i32>(CONTROL_STATUS).store(STATUS_READY);
    }
}
