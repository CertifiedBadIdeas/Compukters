fn read_storage0_blocks(lba: i32, block_count: i32, buffer_addr: i32) -> i32 {
    unsafe {
        mmio<i32>(storage0::LBA_LOW).store(lba);
        mmio<i32>(storage0::LBA_HIGH).store(0);
        mmio<i32>(storage0::BLOCK_COUNT).store(block_count);
        mmio<i32>(storage0::BUFFER_ADDR).store(buffer_addr);
        mmio<i32>(storage0::COMMAND).store(storage0::COMMAND_READ_BLOCKS);
        return mmio<i32>(storage0::STATUS).load();
    }
}

fn load_boot_payload() {
    unsafe {
        let mut entry_pc: i32 = ptr<i32>(516u32).load();
        let mut load_addr: i32 = ptr<i32>(520u32).load();
        let mut block_count: i32 = ptr<i32>(524u32).load();
        let mut start_lba: i32 = ptr<i32>(528u32).load();

        if entry_pc == 0 {
            write_no_bootable_device();
        } else {
            if load_addr == 0 {
                write_no_bootable_device();
            } else {
                if block_count == 0 {
                    write_no_bootable_device();
                } else {
                    if start_lba == 0 {
                        write_no_bootable_device();
                    } else {
                        let mut status: i32 = read_storage0_blocks(
                            start_lba,
                            block_count,
                            load_addr
                        );
                        if status == storage0::STATUS_DONE {
                            write_boot_payload_loaded();
                            rux16_jump(entry_pc);
                        } else {
                            write_no_bootable_device();
                        }
                    }
                }
            }
        }
    }
}

fn find_boot_partition_start_lba() -> i32 {
    unsafe {
        let mut magic: i32 = ptr<i32>(512u32).load();
        if magic == 0x50585552 {
            let mut tail: u8 = ptr<u8>(516u32).load();
            if tail == 84u8 {
                let mut version: u8 = ptr<u8>(517u32).load();
                if version == 1u8 {
                    let mut index: u32 = 0u32;
                    let mut entry_addr: u32 = 528u32;
                    while index < 15u32 {
                        let mut partition_type: i32 = ptr<i32>(entry_addr).load();
                        if partition_type == 0x544f4f42 {
                            let mut start_lba_addr: u32 = entry_addr + 8u32;
                            return ptr<i32>(start_lba_addr).load();
                        }
                        entry_addr = entry_addr + 32u32;
                        index = index + 1u32;
                    }
                }
            }
        }
        return 0;
    }
}

fn probe_boot_ruxfs_superblock(boot_start_lba: i32) -> i32 {
    unsafe {
        if boot_start_lba != 0 {
            let mut status: i32 = read_storage0_blocks(boot_start_lba, 1, 0x6000);
            if status == storage0::STATUS_DONE {
                let mut magic: i32 = ptr<i32>(0x6000u32).load();
                if magic == 0x46585552 {
                    let mut tail: u8 = ptr<u8>(0x6004u32).load();
                    if tail == 83u8 {
                        let mut version: u8 = ptr<u8>(0x6005u32).load();
                        if version == 1u8 {
                            return 1;
                        }
                    }
                }
            }
        }
        return 0;
    }
}

fn probe_boot_ruxfs_inode(boot_start_lba: i32) -> i32 {
    unsafe {
        if probe_boot_ruxfs_superblock(boot_start_lba) == 1 {
            let mut inode_table_start_block: i32 = ptr<i32>(0x6018u32).load();
            let mut root_inode_id: i32 = ptr<i32>(0x6020u32).load();
            if root_inode_id == 1 {
                let mut inode_table_lba: i32 = boot_start_lba + inode_table_start_block;
                let mut status: i32 = read_storage0_blocks(inode_table_lba, 1, 0x6000);
                if status == storage0::STATUS_DONE {
                    let mut root_inode_state: u8 = ptr<u8>(0x6040u32).load();
                    if root_inode_state == 2u8 {
                        return 1;
                    }
                }
            }
        }
        return 0;
    }
}

fn find_boot_directory_inode(boot_start_lba: i32) -> i32 {
    unsafe {
        if probe_boot_ruxfs_inode(boot_start_lba) == 1 {
            let mut root_dir_start_block: i32 = ptr<i32>(0x6060u32).load();
            if root_dir_start_block != 0 {
                let mut root_dir_lba: i32 = boot_start_lba + root_dir_start_block;
                let mut status: i32 = read_storage0_blocks(root_dir_lba, 1, 0x6000);
                if status == storage0::STATUS_DONE {
                    let mut index: u32 = 0u32;
                    let mut entry_addr: u32 = 0x6000u32;
                    while index < 8u32 {
                        let mut entry_state: u8 = ptr<u8>(entry_addr).load();
                        let mut name_len_addr: u32 = entry_addr + 1u32;
                        let mut name_len: u8 = ptr<u8>(name_len_addr).load();
                        if entry_state == 1u8 && name_len == 4u8 {
                            let mut name_addr: u32 = entry_addr + 8u32;
                            let mut name_magic: i32 = ptr<i32>(name_addr).load();
                            if name_magic == 0x746f6f62 {
                                let mut inode_id_addr: u32 = entry_addr + 4u32;
                                return ptr<i32>(inode_id_addr).load();
                            }
                        }
                        entry_addr = entry_addr + 64u32;
                        index = index + 1u32;
                    }
                }
            }
        }
        return 0;
    }
}

fn find_loader_ruxe_inode(boot_start_lba: i32, boot_directory_inode: i32) -> i32 {
    unsafe {
        if boot_directory_inode != 0 && probe_boot_ruxfs_superblock(boot_start_lba) == 1 {
            let mut inode_table_start_block: i32 = ptr<i32>(0x6018u32).load();
            let mut inode_table_lba: i32 = boot_start_lba + inode_table_start_block;
            let mut inode_status: i32 = read_storage0_blocks(inode_table_lba, 1, 0x6000);
            if inode_status == storage0::STATUS_DONE {
                let mut inode_index: i32 = 0;
                let mut inode_addr: u32 = 0x6000u32;
                while inode_index != boot_directory_inode {
                    inode_addr = inode_addr + 64u32;
                    inode_index = inode_index + 1;
                }

                let mut boot_inode_state: u8 = ptr<u8>(inode_addr).load();
                if boot_inode_state == 2u8 {
                    let mut extent_addr: u32 = inode_addr + 32u32;
                    let mut boot_dir_start_block: i32 = ptr<i32>(extent_addr).load();
                    if boot_dir_start_block != 0 {
                        let mut boot_dir_lba: i32 = boot_start_lba + boot_dir_start_block;
                        let mut dir_status: i32 = read_storage0_blocks(boot_dir_lba, 1, 0x6000);
                        if dir_status == storage0::STATUS_DONE {
                            let mut index: u32 = 0u32;
                            let mut entry_addr: u32 = 0x6000u32;
                            while index < 8u32 {
                                let mut entry_state: u8 = ptr<u8>(entry_addr).load();
                                let mut name_len_addr: u32 = entry_addr + 1u32;
                                let mut name_len: u8 = ptr<u8>(name_len_addr).load();
                                if entry_state == 1u8 && name_len == 11u8 {
                                    let mut name_addr: u32 = entry_addr + 8u32;
                                    let mut name0: i32 = ptr<i32>(name_addr).load();
                                    let mut name4_addr: u32 = name_addr + 4u32;
                                    let mut name4: i32 = ptr<i32>(name4_addr).load();
                                    let mut name8_addr: u32 = name_addr + 8u32;
                                    let mut name8: i32 = ptr<i32>(name8_addr).load();
                                    if name0 == 0x64616f6c &&
                                        name4 == 0x722e7265 &&
                                        name8 == 0x00657875 {
                                        let mut inode_id_addr: u32 = entry_addr + 4u32;
                                        return ptr<i32>(inode_id_addr).load();
                                    }
                                }
                                entry_addr = entry_addr + 64u32;
                                index = index + 1u32;
                            }
                        }
                    }
                }
            }
        }
        return 0;
    }
}

fn load_loader_ruxe_from_boot_ruxfs(boot_start_lba: i32, loader_ruxe_inode: i32) -> i32 {
    unsafe {
        if loader_ruxe_inode != 0 && probe_boot_ruxfs_superblock(boot_start_lba) == 1 {
            let mut inode_table_start_block: i32 = ptr<i32>(0x6018u32).load();
            let mut inode_table_lba: i32 = boot_start_lba + inode_table_start_block;
            let mut inode_status: i32 = read_storage0_blocks(inode_table_lba, 1, 0x6000);
            if inode_status == storage0::STATUS_DONE {
                let mut inode_index: i32 = 0;
                let mut inode_addr: u32 = 0x6000u32;
                while inode_index != loader_ruxe_inode {
                    inode_addr = inode_addr + 64u32;
                    inode_index = inode_index + 1;
                }

                let mut file_state: u8 = ptr<u8>(inode_addr).load();
                if file_state == 1u8 {
                    let mut size_addr: u32 = inode_addr + 8u32;
                    let mut file_size_low: i32 = ptr<i32>(size_addr).load();
                    let mut extent_count_addr: u32 = inode_addr + 16u32;
                    let mut extent_count: u8 = ptr<u8>(extent_count_addr).load();
                    if extent_count != 0u8 {
                        let mut extent_start_addr: u32 = inode_addr + 32u32;
                        let mut loader_start_block: i32 = ptr<i32>(extent_start_addr).load();
                        let mut extent_block_count_addr: u32 = inode_addr + 36u32;
                        let mut loader_block_count: i32 = ptr<i32>(extent_block_count_addr).load();
                        if file_size_low != 0 && loader_block_count != 0 {
                            let mut loader_lba: i32 = boot_start_lba + loader_start_block;
                            let mut file_status: i32 = read_storage0_blocks(loader_lba, loader_block_count, 0x6000);
                            if file_status == storage0::STATUS_DONE {
                                let mut ruxe_magic: i32 = ptr<i32>(0x6000u32).load();
                                let mut abi_kind: i32 = ptr<i32>(0x6018u32).load();
                                if ruxe_magic == 0x45585552 && abi_kind == 1 {
                                    return 1;
                                }
                            }
                        }
                    }
                }
            }
        }
        return 0;
    }
}

fn execute_loaded_bootloader_ruxe() {
    unsafe {
        let mut entry_pc: i32 = ptr<i32>(0x600cu32).load();
        let mut section_kind: i32 = ptr<i32>(0x6020u32).load();
        let mut load_addr_i32: i32 = ptr<i32>(0x6024u32).load();
        let mut load_addr: u32 = ptr<u32>(0x6024u32).load();
        let mut payload_offset_i32: i32 = ptr<i32>(0x6028u32).load();
        let mut payload_offset: u32 = ptr<u32>(0x6028u32).load();
        let mut payload_size_i32: i32 = ptr<i32>(0x602cu32).load();
        let mut payload_size: u32 = ptr<u32>(0x602cu32).load();
        let mut memory_size_i32: i32 = ptr<i32>(0x6030u32).load();

        if entry_pc != 0 &&
            section_kind == 1 &&
            load_addr_i32 != 0 &&
            payload_offset_i32 != 0 &&
            payload_size_i32 != 0 &&
            memory_size_i32 == payload_size_i32 {
            let mut copied: u32 = 0u32;
            let mut source_addr: u32 = 0x6000u32 + payload_offset;
            let mut dest_addr: u32 = load_addr;
            while copied < payload_size {
                let mut byte: u8 = ptr<u8>(source_addr).load();
                ptr<u8>(dest_addr).store(byte);
                source_addr = source_addr + 1u32;
                dest_addr = dest_addr + 1u32;
                copied = copied + 1u32;
            }
            write_boot_payload_loaded();
            rux16_jump(entry_pc);
        }

        write_no_bootable_device();
    }
}

fn load_partitioned_bootloader() {
    unsafe {
        let mut boot_start_lba: i32 = find_boot_partition_start_lba();
        let mut boot_directory_inode: i32 = find_boot_directory_inode(boot_start_lba);
        let mut loader_ruxe_inode: i32 = find_loader_ruxe_inode(
            boot_start_lba,
            boot_directory_inode
        );
        let mut loader_ruxe_present: i32 = load_loader_ruxe_from_boot_ruxfs(
            boot_start_lba,
            loader_ruxe_inode
        );
        if loader_ruxe_present == 1 {
            write_boot_loader_found();
            execute_loaded_bootloader_ruxe();
        } else {
            write_no_bootable_device();
        }
    }
}

fn discover_boot_record() {
    unsafe {
        let mut status: i32 = read_storage0_blocks(0, 1, 512);
        if status == storage0::STATUS_DONE {
            let mut magic: i32 = ptr<i32>(512u32).load();
            if magic == 1113085266 {
                write_boot_record_found();
                load_boot_payload();
            } else {
                load_partitioned_bootloader();
            }
        } else {
            write_no_bootable_device();
        }
    }
}

fn main() {
    unsafe {
        mmio<i32>(control::STATUS).store(status::BOOTING);
    }

    write_banner();
    draw_banner();
    discover_boot_record();

    unsafe {
        mmio<i32>(control::PANIC_CODE).store(status::READY);
        mmio<i32>(control::STATUS).store(status::READY);
    }
}
