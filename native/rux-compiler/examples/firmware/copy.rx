fn copy(dst: ptr<u8>, src: ptr<u8>, len: u32) {
    let mut i: u32 = 0u32;
    while i < len {
        unsafe {
            dst[i] = src[i];
        }
        i += 1u32;
    }
}

fn write_bytes(bytes: ptr<u8>, len: u32) {
    let mut i: u32 = 0u32;
    while i < len {
        unsafe {
            mmio<u8>(DEBUG_WRITE).store(bytes[i]);
        }
        i += 1u32;
    }
}

fn main() -> i32 {
    unsafe {
        let mut dst: ptr<u8> = ptr<u8>(RAM_BASE + 32);
        copy(dst, b"RUX", 3u32);
        write_bytes(dst, 3u32);

        return (dst[0u32] as i32)
            + ((dst[1u32] as i32) << 8)
            + ((dst[2u32] as i32) << 16);
    }
}
