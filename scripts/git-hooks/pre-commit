#!/usr/bin/env sh
set -eu

ROOT="$(git rev-parse --show-toplevel)"
SNAPSHOT_REL="docs/benchmarks/k16-vm-current.txt"
SNAPSHOT="$ROOT/$SNAPSHOT_REL"

unstaged_tracked="$(
    git -C "$ROOT" diff --name-only |
        grep -v "^$SNAPSHOT_REL$" || true
)"
untracked="$(
    git -C "$ROOT" ls-files --others --exclude-standard |
        grep -v "^$SNAPSHOT_REL$" || true
)"

if [ -n "$unstaged_tracked$untracked" ]; then
    echo "K16 benchmark pre-commit hook refuses to run with unstaged changes." >&2
    echo "Commit or stage/remove these paths first so the benchmark matches the committed tree:" >&2
    if [ -n "$unstaged_tracked" ]; then
        printf '%s\n' "$unstaged_tracked" >&2
    fi
    if [ -n "$untracked" ]; then
        printf '%s\n' "$untracked" >&2
    fi
    exit 1
fi

echo "Recording current K16 VM benchmark snapshot..." >&2
"$ROOT/scripts/record-k16-vm-benchmark-current.sh"
git -C "$ROOT" add "$SNAPSHOT"
