# K16 setjmp/longjmp machine context.
# jmp_buf words: r4..r11, r12, entry sp, return PC.

.function setjmp
  store32 [r1 + 0], r4
  store32 [r1 + 4], r5
  store32 [r1 + 8], r6
  store32 [r1 + 12], r7
  store32 [r1 + 16], r8
  store32 [r1 + 20], r9
  store32 [r1 + 24], r10
  store32 [r1 + 28], r11
  store32 [r1 + 32], r12
  store32 [r1 + 36], r15
  load32 r14, [r15]
  store32 [r1 + 40], r14
  const32 r0, 0
  ret

.function __k16_longjmp_restore
  load32 r13, [r1 + 36]
  load32 r14, [r1 + 40]
  load32 r4, [r1 + 0]
  load32 r5, [r1 + 4]
  load32 r6, [r1 + 8]
  load32 r7, [r1 + 12]
  load32 r8, [r1 + 16]
  load32 r9, [r1 + 20]
  load32 r10, [r1 + 24]
  load32 r11, [r1 + 28]
  load32 r12, [r1 + 32]
  addi r15, r13, 0
  store32 [r15], r14
  addi r0, r2, 0
  ret
