# Source-built K16 production userland arch runtime.
# This file intentionally covers the helper surface needed by C userland and
# libkraft. Kernel/trap-specific helpers remain outside this production slice.

.function __k16_halt_once
  halt

.function __k16_syscall1
  syscall r1
  ret

.function __k16_syscall3
  const4 r14, 4
  add r14, r15, r14
  load32 r4, [r14]
  syscall r1
  ret

.function __k16_open_syscall
  const32 r14, 0
  add r4, r3, r14
  add r3, r2, r14
  add r2, r1, r14
  const32 r1, 10
  syscall r1
  ret

.function __k16_read_syscall
  const32 r14, 0
  add r4, r3, r14
  add r3, r2, r14
  add r2, r1, r14
  const32 r1, 8
  syscall r1
  ret

.function __k16_write_syscall
  const32 r14, 0
  add r4, r3, r14
  add r3, r2, r14
  add r2, r1, r14
  const32 r1, 7
  syscall r1
  ret

.function __k16_close_syscall
  const32 r14, 0
  add r2, r1, r14
  const32 r1, 11
  syscall r1
  ret

.function __k16_sbrk_syscall
  const32 r14, 0
  add r2, r1, r14
  const32 r1, 13
  syscall r1
  ret
